+//! A default macOS owner serves a separate reader and stops with a typed no-owner answer.
+use crate::{Database, DatabaseOpenOptions, ReadSession, ReadSessionOptions};
+use crate::local_transport::*;
+use contextdb_core::read_contract::{LocalUserIdentity, OwnerServingState, ReadFailureKind};
+use std::io::{BufRead, BufReader, Write};
+use std::os::unix::fs::{MetadataExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+const CASE: &str = "database::macos_locator_tests::default_locator_serves_separate_processes";
+const ROLE: &str = "CDB_LOCATOR_PROOF_ROLE";
+const STORE: &str = "CDB_LOCATOR_PROOF_STORE";
+const ROOT: &str = "CDB_LOCATOR_PROOF_ROOT";
+fn supplied() -> Option<PathBuf> { std::env::var_os(ROOT).map(PathBuf::from) }
+fn no_owner(error: contextdb_core::Error) {
+    match error {
+        contextdb_core::Error::ReadFailure(failure) => assert_eq!(failure.kind(), ReadFailureKind::OwnerNotRunning),
+        other => panic!("typed no-owner required: {other:?}"),
+    }
+}
+fn facts(path: &Path) {
+    let meta = std::fs::symlink_metadata(path).unwrap();
+    let inspection = SystemRuntimeDirectoryInspector.inspect(path).unwrap();
+    println!("FACT path={path:?} canonical={:?} uid={} mode={:o} local={} symlink={} bytes={}", std::fs::canonicalize(path).unwrap(), meta.uid(), meta.mode() & 0o7777, inspection.is_local, meta.file_type().is_symlink(), path.as_os_str().as_encoded_bytes().len());
+    assert!(inspection.is_local);
+    assert!(!meta.file_type().is_symlink());
+}
+fn child(role: &str, store: &Path) {
+    for variable in ["CONTEXTDB_OWNER_READ_RUNTIME_DIR", "XDG_RUNTIME_DIR", "TMPDIR"] {
+        assert!(std::env::var_os(variable).is_none(), "masking variable inherited: {variable}");
+    }
+    println!("CHILD role={role} pid={} euid={} store={store:?} explicit={:?} runtime_env=unset xdg=unset tmpdir=unset", std::process::id(), unsafe { libc::geteuid() }, supplied());
+    let root = supplied();
+    match role {
+        "owner" => {
+            let getconf = Command::new("/usr/bin/getconf").arg("DARWIN_USER_TEMP_DIR").env_clear().output().unwrap();
+            assert!(getconf.status.success() && getconf.stderr.is_empty());
+            println!("GETCONF_RAW {:?}", getconf.stdout);
+            let raw = PathBuf::from(String::from_utf8(getconf.stdout).unwrap().trim_end_matches('\n'));
+            let canonical_raw = std::fs::canonicalize(&raw).unwrap();
+            println!("GETCONF_CANONICAL {canonical_raw:?}");
+            facts(&canonical_raw);
+            let mut options = DatabaseOpenOptions::default();
+            options.owner_reads.runtime_dir = root.clone();
+            let database = Database::open_with_options(store, options).expect("writer opens");
+            let status = database.owner_read_status();
+            println!("OWNER_STATUS {status:?}");
+            let uid = LocalUserIdentity(unsafe { libc::geteuid() } as u64);
+            let resolved = runtime_directory_for_store(root.as_deref(), uid);
+            if let Err(LocalTransportError::ChannelPath(ChannelPathViolation::PathTooLong)) = &resolved {
+                assert_eq!(status.state, OwnerServingState::NotServing);
+                println!("MACLOCATOR_EXPECTED_PATH_TOO_LONG");
+                return;
+            }
+            let runtime = resolved.expect("actual runtime resolves");
+            let address = derive_channel_address(store).unwrap();
+            let expected = format!("{}.sock", blake3::hash(std::fs::canonicalize(store).unwrap().as_os_str().as_encoded_bytes()).to_hex());
+            assert_eq!(opaque_channel_basename(address), expected);
+            assert_eq!(expected.len(), 69);
+            if status.state != OwnerServingState::Serving {
+                assert!(matches!(channel_socket_path(runtime.path(), address), Err(LocalTransportError::ChannelPath(ChannelPathViolation::PathTooLong))), "startup refusal must be precisely typed PathTooLong: {status:?}");
+                println!("MACLOCATOR_EXPECTED_PATH_TOO_LONG");
+                return;
+            }
+            let socket = channel_socket_path(runtime.path(), address).unwrap();
+            facts(runtime.path());
+            let leaf = std::fs::symlink_metadata(runtime.path()).unwrap();
+            assert_eq!(leaf.uid() as u64, uid.0);
+            assert_eq!(leaf.mode() & 0o7777, 0o700);
+            if root.is_none() {
+                let parent = runtime.path().parent().unwrap();
+                facts(parent);
+                let metadata = std::fs::symlink_metadata(parent).unwrap();
+                assert_eq!(metadata.uid(), 0);
+                assert_ne!(metadata.mode() & 0o1000, 0);
+            } else { assert_eq!(runtime.path(), root.as_ref().unwrap()); }
+            assert!(socket.as_os_str().as_encoded_bytes().len() <= 103);
+            let channel = inspect_channel_path(&socket, runtime.path()).unwrap();
+            validate_channel_path(&channel, uid).unwrap();
+            println!("SOCKET {:?} bytes={} full_key={expected}", socket, socket.as_os_str().as_encoded_bytes().len());
+            println!("LOCATOR_OWNER_READY");
+            std::io::stdout().flush().unwrap();
+            let mut release = String::new();
+            std::io::stdin().read_line(&mut release).unwrap();
+            assert_eq!(release.trim(), "release");
+            drop(database);
+            println!("LOCATOR_OWNER_RELEASED");
+        }
+        "reader" => {
+            let session = ReadSession::open_owner_only_in_runtime_dir(store, ReadSessionOptions::default(), root).expect("separate process reaches owner");
+            println!("LIVE_OWNER_ROUTE {:?}", session.route());
+        }
+        "wrong-root" => {
+            match ReadSession::open_owner_only_in_runtime_dir(store, ReadSessionOptions::default(), root) {
+                Ok(_) => panic!("different root unexpectedly reaches owner"),
+                Err(contextdb_core::Error::ReadFailure(failure)) => {
+                    println!("DIFFERENT_ROOT_TYPED_REFUSAL {:?}", failure.kind());
+                    assert!(matches!(failure.kind(), ReadFailureKind::OwnerNotRunning | ReadFailureKind::OwnerNotServing));
+                }
+                Err(other) => panic!("different-root refusal must be typed: {other:?}"),
+            }
+        }
+        "no-owner" => {
+            match ReadSession::open_owner_only_in_runtime_dir(store, ReadSessionOptions::default(), root) {
+                Ok(_) => panic!("stopped owner unexpectedly answered"), Err(error) => no_owner(error),
+            }
+            println!("TYPED_NO_OWNER");
+        }
+        "stopped" => { let _session = ReadSession::open_in_runtime_dir(store, ReadSessionOptions::default(), root).expect("stopped store remains readable"); println!("STOPPED_READ_PASS"); }
+        _ => panic!("unknown role"),
+    }
+}
+fn command(role: &str, store: &Path, root: Option<&Path>) -> Command {
+    let mut command = Command::new(std::env::current_exe().unwrap());
+    command.args(["--exact", CASE, "--nocapture"]).env(ROLE, role).env(STORE, store)
+        .env_remove("CONTEXTDB_OWNER_READ_RUNTIME_DIR").env_remove("XDG_RUNTIME_DIR").env_remove("TMPDIR").env_remove(ROOT)
+        .stdout(Stdio::piped()).stderr(Stdio::inherit());
+    if let Some(root) = root { command.env(ROOT, root); }
+    command
+}
+fn run(role: &str, store: &Path, root: Option<&Path>) {
+    let output = command(role, store, root).stdin(Stdio::null()).output().unwrap();
+    print!("{}", String::from_utf8_lossy(&output.stdout));
+    assert!(output.status.success(), "child role {role} failed");
+}
+struct Owner(std::process::Child);
+impl Drop for Owner { fn drop(&mut self) { let _ = self.0.kill(); let _ = self.0.wait(); } }
+fn journey(store: &Path, root: Option<&Path>, other: Option<&Path>) -> bool {
+    let mut owner = Owner(command("owner", store, root).stdin(Stdio::piped()).spawn().unwrap());
+    let mut output = BufReader::new(owner.0.stdout.take().unwrap());
+    let mut typed_long = false;
+    loop {
+        let mut line = String::new();
+        if output.read_line(&mut line).unwrap() == 0 {
+            assert!(owner.0.wait().unwrap().success());
+            assert!(typed_long, "owner failed before service for an unrelated reason");
+            return false;
+        }
+        print!("{line}");
+        typed_long |= line.contains("MACLOCATOR_EXPECTED_PATH_TOO_LONG");
+        if line.contains("LOCATOR_OWNER_READY") { break; }
+    }
+    run("reader", store, root);
+    if let Some(other) = other { run("wrong-root", store, Some(other)); }
+    writeln!(owner.0.stdin.as_mut().unwrap(), "release").unwrap();
+    let mut tail = String::new();
+    std::io::Read::read_to_string(&mut output, &mut tail).unwrap();
+    print!("{tail}");
+    assert!(owner.0.wait().unwrap().success());
+    assert!(tail.contains("LOCATOR_OWNER_RELEASED"));
+    run("no-owner", store, root);
+    let companion = contextdb_core::store_companion_path(store);
+    let before = (std::fs::read(store).unwrap(), std::fs::read(&companion).unwrap());
+    run("stopped", store, root);
+    assert_eq!(before, (std::fs::read(store).unwrap(), std::fs::read(companion).unwrap()));
+    true
+}
+#[test]
+fn default_locator_serves_separate_processes() {
+    if let Ok(role) = std::env::var(ROLE) { child(&role, &PathBuf::from(std::env::var_os(STORE).unwrap())); return; }
+    let base = std::fs::canonicalize("/tmp").unwrap();
+    let stores = tempfile::Builder::new().prefix("s").tempdir_in(&base).unwrap();
+    let root = tempfile::Builder::new().prefix("r").tempdir_in(&base).unwrap();
+    let other = tempfile::Builder::new().prefix("x").tempdir_in(&base).unwrap();
+    for path in [root.path(), other.path()] { std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o700)).unwrap(); }
+    assert!(journey(&stores.path().join("explicit.db"), Some(root.path()), Some(other.path())));
+    let short = journey(&stores.path().join("s.db"), None, None);
+    let normal_dir = stores.path().join("application-support/context-graph/stores/default");
+    std::fs::create_dir_all(&normal_dir).unwrap();
+    let normal = journey(&normal_dir.join("context-graph.db"), None, None);
+    assert!(short && normal, "MACLOCATOR_DEFAULT_SERVICE_REQUIRED short={short} normal={normal}");
+}
