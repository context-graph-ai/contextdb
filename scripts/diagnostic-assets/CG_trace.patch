+// Disposable external diagnostic only; remove this module with the patch.
+mod external_trace {
+    use std::fmt::{self, Write as _};
+    use std::io::Write as _;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    const LIMIT: usize = 48;
+    const STREAM: &str = "cg";
+    static NEXT: AtomicUsize = AtomicUsize::new(0);
+
+    pub(super) fn enabled() -> bool {
+        std::env::var_os("SUBSCRIPTION_EXTERNAL_TRACE").as_deref()
+            == Some(std::ffi::OsStr::new("external-472-v1"))
+    }
+
+    fn sink_id(sink: &str) -> Option<&str> {
+        let id = sink.strip_prefix("cg_subscription_new_decision_")?;
+        (id.len() == 32 && id.bytes().all(|b| b.is_ascii_hexdigit())).then_some(id)
+    }
+
+    // Slots are reservation order within this stream, not cross-crate causal order.
+    pub(super) fn emit(sink: &str, fields: impl FnOnce(&mut Line)) {
+        if !enabled() {
+            return;
+        }
+        let Some(sink) = sink_id(sink) else { return };
+        let Ok(slot) = NEXT.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| {
+            (n < LIMIT).then_some(n + 1)
+        }) else { return };
+        let mut line = Line { bytes: [0; 2048], len: 0, clipped: false };
+        let epoch_ns = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_nanos()).unwrap_or(0);
+        let _ = write!(line, "EXTSUB1 stream={} pid={} seq={} epoch_ns={} sink={} ",
+            STREAM, std::process::id(), slot + 1, epoch_ns, sink);
+        if slot + 1 == LIMIT {
+            let _ = write!(line, "event=truncated limit={}", LIMIT);
+        } else {
+            fields(&mut line);
+        }
+        // Reserve space for an explicit clipping marker and the final newline.
+        if line.clipped {
+            let suffix = b" record_clipped=1";
+            let end = line.len + suffix.len();
+            line.bytes[line.len..end].copy_from_slice(suffix);
+            line.len = end;
+        }
+        line.bytes[line.len] = b'\n';
+        line.len += 1;
+        // Trace failure never changes delivery, persistence or the test result.
+        let _ = std::io::stderr().lock().write_all(&line.bytes[..line.len]);
+    }
+
+    pub(super) struct Line {
+        bytes: [u8; 2048],
+        len: usize,
+        clipped: bool,
+    }
+
+    impl fmt::Write for Line {
+        fn write_str(&mut self, text: &str) -> fmt::Result {
+            let available = (self.bytes.len() - 32).saturating_sub(self.len);
+            let n = available.min(text.len());
+            self.bytes[self.len..self.len + n].copy_from_slice(&text.as_bytes()[..n]);
+            self.len += n;
+            self.clipped |= n != text.len();
+            Ok(())
+        }
+    }
+
+    #[allow(dead_code)] // Only the engine stream needs bounded ID prefixes.
+    pub(super) fn ids(out: &mut Line, key: &str, ids: impl Iterator<Item = u64>) {
+        let _ = write!(out, " {}=", key);
+        for (i, id) in ids.take(8).enumerate() {
+            let _ = write!(out, "{}{}", if i == 0 { "" } else { "," }, id);
+        }
+    }
+}
+
+macro_rules! external_trace {
+    ($sink:expr, $($fields:tt)*) => {
+        external_trace::emit($sink, |out| {
+            use std::fmt::Write as _;
+            let _ = write!(out, $($fields)*);
+        })
+    };
+}
 
