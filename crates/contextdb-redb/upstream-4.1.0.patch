+#[doc(hidden)]
+#[derive(Debug, Clone, Copy)]
+pub struct NativeColdFault {
+    pub reason: &'static str,
+    pub page: [u8; 8],
+    pub offset: usize,
+    pub expected: u128,
+    pub actual: u128,
+}
+impl NativeColdFault {
+    pub(crate) fn new(reason: &'static str) -> Self {
+        Self {
+            reason,
+            page: [0; 8],
+            offset: 0,
+            expected: 0,
+            actual: 0,
+        }
