+                    if cutoff.is_none_or(|cutoff| key.value().transaction_id <= cutoff) {
+                        counts[index].0 += 1;
+                        counts[index].1 += pages.value().len();
+                    }
+                }
+            }
+        }
+        write.abort().unwrap();
