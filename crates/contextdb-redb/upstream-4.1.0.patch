+        impl Drop for Charge {
+            fn drop(&mut self) {
+                self.0.fetch_sub(self.1, AtomicOrdering::SeqCst);
+            }
+        }
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("bounded.db");
+        create(&path, false);
