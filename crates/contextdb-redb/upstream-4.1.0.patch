+    /// fit that geometry.
+    fn adopt_or_recount_free_totals(state: &mut InMemoryState, saved: Option<&[u8]>) -> Result {
+        let layout = state.header.layout();
+        match saved.and_then(|bytes| FreeTotals::decode_for_layout(bytes, &layout)) {
