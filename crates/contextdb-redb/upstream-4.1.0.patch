+            }
+            if progress.complete {
+                completed = true;
+                break;
+            }
+        }
+        assert!(completed && relocated > 0);
+        let pairs = RELOCATIONS.with(|pairs| pairs.borrow().clone());
+        let reused_holes = pairs
+            .iter()
+            .filter(|(_, to)| old_holes.contains(to))
+            .count();
+        assert!(
