+}
+#[doc(hidden)]
+#[derive(Debug)]
+pub enum NativeColdReadError {
+    AdmissionRefused,
+    TableAbsent,
+    TypeMismatch,
+    Corrupt(NativeColdFault),
+    Io(std::io::Error),
+}
+impl From<NativeStorageRefused> for NativeColdReadError {
+    fn from(_: NativeStorageRefused) -> Self {
+        Self::AdmissionRefused
+    }
+}
