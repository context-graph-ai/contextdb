+        let before = state.lock().unwrap().damaged_reads;
+        check(&table);
+        let after = state.lock().unwrap().damaged_reads;
+        assert!(after > before, "the damaged branch was read");
+        assert!(
+            after <= before + 2,
+            "cycle rejected within bounded page reads"
+        );
