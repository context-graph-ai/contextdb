+            assert_eq!(original.get_point_id(), restored.get_point_id());
+            assert_eq!(
+                original.get_neighborhood_id(),
+                restored.get_neighborhood_id()
+            );
+        }
+        assert_eq!(
+            graph.search(&[59.0, 3.0], 10, 32),
+            loaded.search(&[59.0, 3.0], 10, 32)
+        );
+    }
