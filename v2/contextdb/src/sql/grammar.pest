WHITESPACE = _{ SPACE | line_comment | block_comment }
SPACE = _{ " " | "\t" | "\r" | "\n" }
line_comment = _{ "--" ~ (!"\n" ~ ANY)* }
block_comment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

statement = { SOI ~ stmt ~ ";"? ~ EOI }
stmt = _{
    stored_procedure
    | create_table_stmt
    | create_index_stmt
    | alter_table_stmt
    | drop_table_stmt
    | drop_index_stmt
    | insert_stmt
    | delete_stmt
    | purge_stmt
    | update_stmt
    | set_setting
    | show_setting
    | reset_stmt
    | explain_stmt
    | select_stmt
    | create_trigger_stmt | create_event_type_stmt | create_sink_stmt | create_route_stmt
    | create_schedule_stmt | drop_trigger_stmt | drop_route_stmt | drop_schedule_stmt
    | !with_word ~ later
}

// A statement or clause that a later version of the library reads, or that no version reads
// (IVF and SEARCH). It is recognised by its first words alone and the rest of the text is left
// unread, so that the statement is refused by that name and not as a syntax error. `later`
// stands only where nothing this version reads can begin with one of these words: after a whole
// statement or clause, and after an expression, where ILIKE and the two other distances would
// follow. A statement that begins with WITH is a SELECT.
later = { later_name ~ ANY* }
later_name = @{
    (
        ^"SHOW" ~ SPACE+
        ~ (^"TENANT" | ^"SYNC" | ^"DELIVERY")
        | ^"SET" ~ SPACE+ ~ !(setting_known ~ !ident_char) ~ identifier
        | ^"FOLLOWS"
        | ^"WITH" | ^"BEGIN" | ^"COMMIT" | ^"ROLLBACK" | ^"DISCARD"
        | ^"DECLARE"
        | (^"NOT" ~ SPACE+)? ~ ^"ILIKE"
        | ^"SEARCH" | ^"IVF"
    ) ~ !ident_char
    | "<->" | "<#>"
}
// The word a SELECT in parentheses opens with. It is looked ahead for, so that what stands in
// parentheses is read once: as a SELECT or as expressions.
subquery = @{ ^"SELECT" ~ !ident_char }
// The options after the mode of USE VECTOR are a later version's and begin with a mark this
// version reads, so they are known by where they stand. Like `later`, the rule leaves the rest
// of the text unread.
vector_options = { "(" }

setting_known = _{ ^"MEMORY_LIMIT" | ^"DISK_LIMIT" | ^"MAINTENANCE_POLL_INTERVAL" | ^"UNINDEXED_VECTOR_LIMIT" | ^"STATEMENT_STATISTICS_LIMIT" }
reset_stmt = { ^"RESET" ~ ^"STATEMENT_STATISTICS" ~ &(";" | EOI) }
set_setting = { ^"SET" ~ setting_name ~ "="? ~ setting_value }
show_setting = { ^"SHOW" ~ setting_name ~ (^"FOR" ~ identifier ~ "." ~ identifier)? ~ (limit_clause ~ offset_clause?)? ~ &(";" | EOI) }
setting_name = @{ ^"STORAGE_COMPACTION" ~ (SPACE+ ~ identifier)? | identifier }
setting_value = { setting_quoted | setting_word+ }
setting_quoted = @{ "'" ~ (!"'" ~ ANY)* ~ "'" }
setting_word = @{ (!(";" | "--" | "/*" | SPACE | EOI) ~ ANY)+ }

explain_stmt = { ^"EXPLAIN" ~ stmt }


// ORDER BY and what follows it are over the whole statement: over every SELECT of a UNION.
select_stmt = {
    with_clause? ~ select_core ~ (set_op ~ all? ~ select_core)*
    ~ order_by_clause? ~ use_vector_clause? ~ use_rank_clause? ~ limit_clause? ~ offset_clause?
    ~ later?
}
with_clause = { with_word ~ recursive? ~ cte ~ ("," ~ cte)* }
with_word = @{ ^"WITH" ~ !ident_char }
// WITH RECURSIVE, which no version has: it is read so that it is refused by its own kind.
recursive = @{ ^"RECURSIVE" ~ !ident_char }
cte = { identifier ~ ^"AS" ~ "(" ~ select_stmt ~ ")" }
// INTERSECT and EXCEPT, RIGHT and FULL JOIN and a second table after a comma are no version's:
// each is read so that it is refused by its name.
set_op = @{ (^"UNION" | ^"INTERSECT" | ^"EXCEPT") ~ !ident_char }
all = @{ ^"ALL" ~ !ident_char }
select_core = {
    ^"SELECT" ~ distinct? ~ select_list
    ~ (^"FROM" ~ (graph_table | table_ref ~ more_tables? ~ join*))?
    ~ where_clause? ~ group_by_clause? ~ having_clause?
}
distinct = @{ ^"DISTINCT" ~ !ident_char }
table_ref = { derived_table | identifier ~ alias? }
derived_table = { lateral? ~ "(" ~ select_stmt ~ ")" ~ (alias ~ columns?)? }
lateral = @{ ^"LATERAL" ~ !ident_char }
// The rows a pattern matches over an edge table, which stands alone in FROM. A step with no
// count is one hop; `+`, `*` and a count with no upper bound are read so that each is refused
// by its own name.
graph_table = {
    ^"GRAPH_TABLE" ~ "(" ~ identifier ~ ^"MATCH" ~ node_pattern ~ edge_step+
    ~ where_clause? ~ graph_columns? ~ ")"
}
node_pattern = { "(" ~ identifier? ~ label? ~ ")" }
label = { ":" ~ as_written }
edge_step = { (incoming ~ edge ~ "-" | "-" ~ edge ~ outgoing | "-" ~ edge ~ "-") ~ hops? ~ node_pattern }
incoming = { "<-" }
outgoing = { "->" }
edge = { "[" ~ identifier? ~ label? ~ "]" }
hops = { "+" | "*" | "{" ~ integer ~ "," ~ integer? ~ "}" }
graph_columns = { ^"COLUMNS" ~ "(" ~ select_item ~ ("," ~ select_item)* ~ ")" }
more_tables = { "," ~ ANY* }
join = { cross ~ table_ref | join_kind ~ table_ref ~ ^"ON" ~ expr }
cross = { ^"CROSS" ~ join_word }
join_kind = { (^"INNER" | ^"LEFT" | ^"RIGHT" | ^"FULL")? ~ join_word }
join_word = @{ ^"JOIN" ~ !ident_char }
// A name given with AS, or without it when the word begins no clause.
alias = ${ as_alias | !clause_word ~ identifier }
// Without AS, the name of a select item is a name only before what may follow an item, so that
// a misspelt FROM is the word a syntax error stops at.
item_alias = ${ as_alias | !clause_word ~ identifier ~ &(WHITESPACE* ~ ("," | ")" | ";" | !ANY | clause_word)) }
as_alias = _{ ^"AS" ~ !ident_char ~ WHITESPACE* ~ identifier }
clause_word = _{
    (
        ^"FROM" | ^"WHERE" | ^"JOIN" | ^"INNER" | ^"LEFT" | ^"RIGHT" | ^"FULL" | ^"CROSS" | ^"ON"
        | ^"GROUP" | ^"HAVING" | ^"UNION" | ^"INTERSECT" | ^"EXCEPT" | ^"ORDER" | ^"USE"
        | ^"LIMIT" | ^"OFFSET"
    ) ~ !ident_char
}
select_list = { star | select_item ~ ("," ~ select_item)* }
star = { "*" }
select_item = { expr ~ item_alias? }
where_clause = { ^"WHERE" ~ expr }
order_by_clause = { ^"ORDER" ~ ^"BY" ~ order_item ~ ("," ~ order_item)* }
order_item = { expr ~ sort_dir? }
sort_dir = { ^"ASC" | ^"DESC" }
use_vector_clause = { ^"USE" ~ ^"VECTOR" ~ search_mode ~ (vector_options ~ ANY*)? }
search_mode = @{ (^"AUTO" | ^"EXACT" | ^"INDEXED") ~ !ident_char }
use_rank_clause = { ^"USE" ~ ^"RANK" ~ identifier }
limit_clause = { ^"LIMIT" ~ (integer | parameter) }
offset_clause = { ^"OFFSET" ~ (integer | parameter) }
group_by_clause = { ^"GROUP" ~ ^"BY" ~ expr ~ ("," ~ expr)* }
having_clause = { ^"HAVING" ~ expr }

create_table_stmt = {
    ^"CREATE" ~ ^"TABLE" ~ if_not_exists? ~ identifier
    ~ "(" ~ table_element ~ ("," ~ table_element)*
    // A later clause may follow a column, stand as an element of its own, or follow the list.
    ~ (")" ~ table_option* ~ later? | ","? ~ later)
}
// The program stored in a database that no version reads: it is refused by its own kind.
stored_procedure = { ^"CREATE" ~ stored_word ~ ANY* }
stored_word = @{ (^"PROCEDURE" | ^"FUNCTION") ~ !ident_char }
if_not_exists = { ^"IF" ~ ^"NOT" ~ ^"EXISTS" }
table_element = _{ column_def | unique_table_constraint | primary_key_columns | foreign_key }
unique_table_constraint = { ^"UNIQUE" ~ "(" ~ identifier ~ ("," ~ identifier)* ~ ")" }
primary_key_columns = { ^"PRIMARY" ~ ^"KEY" ~ columns }
foreign_key = { ^"FOREIGN" ~ ^"KEY" ~ columns ~ ^"REFERENCES" ~ identifier ~ columns ~ follows_parent_purge? }
columns = { "(" ~ identifier ~ ("," ~ identifier)* ~ ")" }
column_def = { identifier ~ data_type ~ column_constraint* }
data_type = {
    vector_type
    | ^"UUID" | ^"TEXT" | ^"INTEGER" | ^"INT" | ^"REAL" | ^"FLOAT" | ^"BOOLEAN" | ^"BOOL"
    | ^"TIMESTAMP" | ^"TXID" | ^"JSON"
}
vector_type = {
    ^"VECTOR" ~ "(" ~ integer ~ ")"
    ~ quantization? ~ partition_key? ~ max_partitions? ~ (^"SEARCH_MODE" ~ search_mode)?
    ~ indexing_threshold? ~ probes? ~ compaction?
    // WITH stands first or nowhere: after another clause it is no clause of a later version.
    ~ !(^"WITH" ~ !ident_char)
}
quantization = { ^"WITH" ~ "(" ~ ^"quantization" ~ "=" ~ string ~ ")" }
partition_key = { ^"PARTITION_KEY" ~ "(" ~ identifier ~ ("," ~ identifier)* ~ ")" }
max_partitions = { ^"MAX_PARTITIONS" ~ signed }
indexing_threshold = { ^"INDEXING_THRESHOLD" ~ signed }
probes = { ^"PROBES" ~ signed }
compaction = {
    ^"COMPACTION"
    ~ (
        ^"NONE"
        | "("
          ~ (change_percent ~ ("," ~ tombstone_percent)? | tombstone_percent ~ ("," ~ change_percent)?)
          ~ ")"
    )
}
change_percent = { ^"CHANGE_PERCENT" ~ "=" ~ signed }
tombstone_percent = { ^"TOMBSTONE_PERCENT" ~ "=" ~ signed }
// Read with its sign, so that `schema` refuses zero and a negative number by their kind.
signed = @{ "-"? ~ ASCII_DIGIT+ }
column_constraint = _{
    not_null | nullable_marker | primary_key | unique | default_clause
    | references | immutable | context_id | scope_labels | acl | rank_policy | expires
}
expires = { ^"EXPIRES" }
not_null = { ^"NOT" ~ ^"NULL" }
nullable_marker = { ^"NULL" }
primary_key = { ^"PRIMARY" ~ ^"KEY" }
unique = { ^"UNIQUE" }
default_clause = { ^"DEFAULT" ~ expr }
references = { ^"REFERENCES" ~ identifier ~ "(" ~ identifier ~ ")" ~ follows_parent_purge? ~ propagation? }
follows_parent_purge = { ^"FOLLOWS" ~ ^"PARENT" ~ ^"PURGE" }
propagation = {
    ^"ON" ~ ^"STATE" ~ as_written ~ ^"PROPAGATE" ~ ^"SET" ~ as_written ~ max_depth? ~ abort_on_failure?
}
max_depth = { ^"MAX" ~ ^"DEPTH" ~ integer }
abort_on_failure = { ^"ABORT" ~ ^"ON" ~ ^"FAILURE" }
// A state or an edge type, which is a value that rows hold, and the name of a function: none
// of them is folded to lower case as the name of a table, a column or an index is.
as_written = { quoted_ident | ident }
immutable = { ^"IMMUTABLE" }
context_id = { ^"CONTEXT_ID" }
scope_labels = { ^"SCOPE_LABEL_READ" ~ scope_list ~ ^"WRITE" ~ scope_list | ^"SCOPE_LABEL" ~ scope_list }
scope_list = _{ labels | empty_labels }
empty_labels = { "(" ~ ")" }
labels = { "(" ~ string ~ ("," ~ string)* ~ ")" }
acl = { ^"ACL" ~ ^"REFERENCES" ~ identifier ~ "(" ~ identifier ~ ")" }
rank_policy = {
    ^"RANK_POLICY" ~ "(" ~ ^"JOIN" ~ identifier ~ ^"ON" ~ identifier
    ~ "," ~ ^"FORMULA" ~ string ~ "," ~ ^"SORT_KEY" ~ identifier ~ ")"
}

table_option = _{
    immutable | state_machine | dag | propagate_edge | exclude_vector | retain | history
    | sync_conflict | sync | maintain_count | delivery_manifest | edge_discard
}
state_machine = {
    (^"STATE_MACHINE" | ^"STATE" ~ ^"MACHINE")
    ~ "(" ~ identifier ~ ":" ~ transition ~ ("," ~ transition)* ~ ")"
}
transition = { as_written ~ "->" ~ ("[" ~ as_written ~ ("," ~ as_written)* ~ "]" | as_written) }
dag = { ^"DAG" ~ "(" ~ string ~ ("," ~ string)* ~ ")" }
propagate_edge = {
    ^"PROPAGATE" ~ ^"ON" ~ ^"EDGE" ~ as_written ~ edge_direction
    ~ ^"STATE" ~ as_written ~ ^"SET" ~ as_written ~ max_depth? ~ abort_on_failure?
}
edge_direction = { ^"INCOMING" | ^"OUTGOING" | ^"BOTH" }
exclude_vector = { ^"PROPAGATE" ~ ^"ON" ~ ^"STATE" ~ as_written ~ ^"EXCLUDE" ~ ^"VECTOR" }
retain = { ^"RETAIN" ~ integer ~ retain_unit ~ sync_safe? }
retain_unit = { ^"SECONDS" | ^"MINUTES" | ^"HOURS" | ^"DAYS" }
// RETAIN names no direction. One written here is read so that the refusal can name the clause
// to write instead.
sync_safe = { ^"SYNC" ~ ^"SAFE" ~ nested_direction? }
nested_direction = { ^"PUSH" ~ ^"ONLY" | ^"TWO" ~ ^"WAY" }
history = { ^"HISTORY" ~ history_kept }
history_kept = { ^"ALL" | ^"CURRENT" ~ ^"ONLY" }
sync = { ^"SYNC" ~ sync_direction }
sync_direction = { ^"OFF" | ^"PUSH" ~ ^"ONLY" | ^"PULL" ~ ^"ONLY" | ^"TWO" ~ ^"WAY" }
sync_conflict = { ^"SYNC" ~ ^"CONFLICT" ~ ^"KEEP" ~ conflict_kept }
conflict_kept = { ^"FIRST" | ^"LATEST" }
// DEFAULT takes a declared list away, so a new table is refused for it by the builder.
maintain_count = { ^"MAINTAIN" ~ ^"COUNT" ~ (count_word | count_list ~ ("," ~ count_list)*) }
count_word = { ^"ALL" ~ ^"PREFIXES" | ^"NONE" | ^"DEFAULT" }
count_list = { "(" ~ indexed_column ~ ("," ~ indexed_column)* ~ ")" }
delivery_manifest = { ^"DELIVERY" ~ ^"MANIFEST" ~ ^"OVER" ~ identifier ~ ("," ~ identifier)* }
edge_discard = { ^"EDGE" ~ ^"DISCARD" ~ discard_when }
discard_when = { ^"NEVER" | ^"AFTER" ~ ^"OUTCOME" | ^"ALWAYS" }

create_index_stmt = {
    ^"CREATE" ~ ^"INDEX" ~ identifier ~ ^"ON" ~ identifier
    ~ "(" ~ (json_path | indexed_column ~ ("," ~ indexed_column)*) ~ ")"
}
// A path into a JSON column, written as an expression in its own parentheses.
json_path = { "(" ~ identifier ~ ("->" ~ string)+ ~ ")" }
indexed_column = { identifier ~ sort_dir? }

alter_table_stmt = { ^"ALTER" ~ ^"TABLE" ~ identifier ~ alter_action }
alter_action = _{
    add_column | drop_retain | drop_column | rename_column | alter_column
    | ^"SET" ~ (retain | history | sync_conflict | sync | maintain_count)
}
// The clauses of a later version may follow the column, as in CREATE TABLE.
add_column = { ^"ADD" ~ column_word? ~ column_def ~ later? }
drop_retain = { ^"DROP" ~ retain_word }
drop_column = { ^"DROP" ~ column_word? ~ identifier ~ drop_behaviour? }
drop_behaviour = { ^"RESTRICT" | ^"CASCADE" }
rename_column = { ^"RENAME" ~ column_word ~ identifier ~ ^"TO" ~ identifier }
// The clauses of a VECTOR column that may change, DEFAULT taking one back to what a column that
// does not write it has; the SET of any other is a later version's.
alter_column = {
    ^"ALTER" ~ column_word ~ identifier ~ ^"SET"
    ~ (
        ^"MAX_PARTITIONS" ~ signed | ^"SEARCH_MODE" ~ search_mode | indexing_threshold | probes | compaction
        | indexing_threshold_default | probes_default | compaction_default | later
    )
}
indexing_threshold_default = { ^"INDEXING_THRESHOLD" ~ ^"DEFAULT" }
probes_default = { ^"PROBES" ~ ^"DEFAULT" }
compaction_default = { ^"COMPACTION" ~ ^"DEFAULT" }
// Whole words, so that a column whose name begins with one is still a column.
column_word = @{ ^"COLUMN" ~ !ident_char }
retain_word = @{ ^"RETAIN" ~ !ident_char }

drop_table_stmt = { ^"DROP" ~ ^"TABLE" ~ if_exists? ~ identifier }
drop_index_stmt = { ^"DROP" ~ ^"INDEX" ~ if_exists? ~ identifier ~ on_table? }
on_table = { ^"ON" ~ identifier }
if_exists = { ^"IF" ~ ^"EXISTS" }

insert_stmt = {
    ^"INSERT" ~ ^"INTO" ~ identifier
    ~ ("(" ~ identifier ~ ("," ~ identifier)* ~ ")")?
    ~ (^"VALUES" ~ values_row ~ ("," ~ values_row)* ~ on_conflict? ~ later? | insert_select)
}
// INSERT ... SELECT, which no version has: its first word is read so that it is refused by name.
insert_select = { subquery ~ ANY* }
on_conflict = {
    ^"ON" ~ ^"CONFLICT" ~ columns ~ ^"DO" ~ ^"UPDATE" ~ ^"SET" ~ assignment ~ ("," ~ assignment)*
}
values_row = { "(" ~ expr ~ ("," ~ expr)* ~ ")" }
assignment = { identifier ~ "=" ~ expr }

purge_stmt = { ^"PURGE" ~ ^"FROM" ~ purge_selection ~ ("," ~ purge_selection)* }
purge_selection = { identifier ~ where_clause? }
delete_stmt = { ^"DELETE" ~ ^"FROM" ~ identifier ~ where_clause? }
update_stmt = { ^"UPDATE" ~ identifier ~ ^"SET" ~ assignment ~ ("," ~ assignment)* ~ where_clause? }

// One level of rule here is one level of the parser's recursion for every parenthesis, so the
// boolean operators share one flat rule and the arithmetic operators another, and the builder
// applies their precedence: NOT, then AND, then OR; `*` and `/` before `+` and `-`.
expr = { not_op* ~ distance_expr ~ comparison_suffix? ~ (bool_op ~ not_op* ~ distance_expr ~ comparison_suffix?)* }
bool_op = _{ and_op | or_op }
or_op = @{ ^"OR" ~ !ident_char }
and_op = @{ ^"AND" ~ !ident_char }
not_op = @{ ^"NOT" ~ !ident_char }

comparison_suffix = _{
    cmp_suffix | &ASCII_ALPHA ~ (is_null_suffix | in_suffix | between_suffix | like_suffix | match_suffix | later)
}
cmp_suffix = { cmp_op ~ distance_expr }
cmp_op = { "=" | "!=" | "<>" | "<=" | ">=" | "<" | ">" }
is_null_suffix = { ^"IS" ~ not_op? ~ ^"NULL" }
in_suffix = { not_op? ~ ^"IN" ~ "(" ~ (&subquery ~ select_stmt | expr ~ ("," ~ expr)*) ~ ")" }
// The AND between the two ends belongs to BETWEEN: it is read here, before `expr` looks for one.
between_suffix = { not_op? ~ between_op ~ distance_expr ~ and_op ~ distance_expr }
like_suffix = { not_op? ~ like_op ~ distance_expr }
// A full-text search, which no version has: it is read so that it is refused by its own kind.
match_suffix = { match_op ~ distance_expr }
// Whole words, so that a name that begins with one is still a name.
between_op = @{ ^"BETWEEN" ~ !ident_char }
like_op = @{ ^"LIKE" ~ !ident_char }
match_op = @{ ^"MATCH" ~ !ident_char }

// The distance operator and the two that read a field of a JSON value bind alike, as in
// Postgres: tighter than a comparison, looser than `+` and `-`, from left to right.
distance_expr = { additive_expr ~ (other_op ~ additive_expr)* }
other_op = { "<=>" | "->>" | "->" }

additive_expr = { unary_minus* ~ primary_expr ~ (math_op ~ unary_minus* ~ primary_expr)* }
math_op = { "+" | "-" | "*" | "/" }
unary_minus = { "-" }

primary_expr = _{
    parameter
    | exists
    | function_call
    | null_lit
    | bool_lit
    | float
    | integer
    | string
    | vector_lit
    | column_ref
    | scalar_select
    | parenthesized
}
// One expression in parentheses is that expression; two or more are a row value. One rule reads
// both: a rule that read the first expression, failed and read it again would double the work
// at every level of nesting.
parenthesized = { "(" ~ expr ~ ("," ~ expr)* ~ ")" }
// A vector is one token, its numbers read from its text.
vector_lit = @{ "[" ~ SPACE* ~ vector_component ~ (SPACE* ~ "," ~ SPACE* ~ vector_component)* ~ SPACE* ~ "]" }
vector_component = _{ "-"? ~ (float | integer) }
function_call = { as_written ~ "(" ~ (star | (expr ~ ("," ~ expr)*))? ~ ")" ~ over? }
// The window of a function. Any function may be written before it: the builder refuses all but
// the one this version has.
over = { ^"OVER" ~ "(" ~ partition_by? ~ order_by_clause? ~ ")" }
partition_by = { ^"PARTITION" ~ ^"BY" ~ expr ~ ("," ~ expr)* }
// A SELECT in parentheses standing as one value, and EXISTS, which no version has: it is read
// so that it is refused by its own kind.
scalar_select = { "(" ~ &subquery ~ select_stmt ~ ")" }
exists = { ^"EXISTS" ~ "(" ~ &subquery ~ select_stmt ~ ")" }
column_ref = { identifier ~ ("." ~ identifier)? }

// A rank formula, which no statement reads: numbers and `{column}`s joined by `+` and `*`, in
// parentheses or in `coalesce(<formula>, <number>)`.
formula = { SOI ~ formula_sum ~ EOI }
formula_sum = { formula_operand ~ (formula_op ~ formula_operand)* }
formula_op = { "+" | "*" }
formula_operand = _{ coalesce | float | integer | braced | "(" ~ formula_sum ~ ")" }
coalesce = { ^"coalesce" ~ "(" ~ formula_sum ~ "," ~ (float | integer) ~ ")" }
braced = { "{" ~ identifier ~ "}" }

parameter = @{ "$" ~ ident }
null_lit = { ^"NULL" }
bool_lit = { ^"TRUE" | ^"FALSE" }
// A number read as Postgres reads a decimal constant: `4.`, `.001`, `5e2`, `1.925e-3`.
float = @{ (ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT* | "." ~ ASCII_DIGIT+) ~ exponent? | ASCII_DIGIT+ ~ exponent }
exponent = _{ ^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+ }
integer = @{ ASCII_DIGIT+ }
string = @{ "'" ~ ("''" | (!"'" ~ ANY))* ~ "'" }

ident_char = _{ ASCII_ALPHANUMERIC | "_" }
ident = @{ (ASCII_ALPHA | "_") ~ ident_char* }
quoted_ident = @{ "\"" ~ ("\"\"" | (!"\"" ~ ANY))* ~ "\"" }
identifier = { quoted_ident | ident }

create_trigger_stmt = { ^"CREATE" ~ ^"TRIGGER" ~ identifier ~ ^"ON" ~ identifier ~ ^"WHEN" ~ event_trigger ~ including_sync_clause? }
including_sync_clause = { ^"INCLUDING" ~ ^"SYNC" }
drop_trigger_stmt = { ^"DROP" ~ ^"TRIGGER" ~ if_exists? ~ identifier ~ on_table? }
create_event_type_stmt = { ^"CREATE" ~ ^"EVENT" ~ ^"TYPE" ~ identifier ~ ^"WHEN" ~ event_trigger ~ ^"ON" ~ identifier }
event_trigger = { ^"INSERT" | ^"UPDATE" | ^"DELETE" }
create_sink_stmt = { ^"CREATE" ~ ^"SINK" ~ identifier ~ ^"TYPE" ~ sink_type ~ sink_url_clause? }
sink_type = { ^"webhook" | ^"callback" }
sink_url_clause = { ^"URL" ~ string }
create_route_stmt = { ^"CREATE" ~ ^"ROUTE" ~ identifier ~ ^"EVENT" ~ identifier ~ ^"TO" ~ identifier ~ route_where_clause? }
route_where_clause = { ^"WHERE" ~ identifier ~ ^"IN" ~ labels }
drop_route_stmt = { ^"DROP" ~ ^"ROUTE" ~ if_exists? ~ identifier }
create_schedule_stmt = { ^"CREATE" ~ ^"SCHEDULE" ~ identifier ~ ^"EVERY" ~ string ~ ^"TX" ~ "(" ~ identifier ~ ")" ~ missed_tick_clause? }
missed_tick_clause = { ^"MISSED_TICK_POLICY" ~ string ~ (^"WITHIN" ~ integer ~ ^"SECONDS")? }
drop_schedule_stmt = { ^"DROP" ~ ^"SCHEDULE" ~ if_exists? ~ identifier }
